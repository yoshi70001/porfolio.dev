---
import Layout from "@/layouts/Layout.astro"
import LinkButton from "@/components/LinkButton.astro"
---

<Layout
  title="404 — Página no encontrada"
  description="La página que buscas no existe en porfolio.dev."
>
  <main class="mx-auto w-full max-w-5xl px-6 pt-40 pb-24 md:pt-52">
    <p class="font-mono text-sm font-medium uppercase tracking-[0.2em] text-accent-700 dark:text-accent-400">
      Error 404
    </p>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight text-ink-900 md:text-6xl dark:text-paper-50">
      Página no encontrada
    </h1>
    <p class="mt-5 max-w-md leading-relaxed text-ink-600 dark:text-ink-300">
      La dirección que buscas no existe o fue movida. Vuelve al inicio para seguir explorando el
      portafolio.
    </p>
    <div class="mt-9">
      <LinkButton href="/" variant="primary">Volver al inicio</LinkButton>
    </div>
  </main>
</Layout>
