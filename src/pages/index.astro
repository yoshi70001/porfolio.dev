---
import Layout from "@/layouts/Layout.astro"

import Hero from "@/components/Hero.astro"
import Experience from "@/components/Experience.astro"
import Projects from "@/components/Projects.astro"
import TechStack from "@/components/TechStack.astro"
import Certifications from "@/components/Certifications.astro"
import BlogFeatured from "@/components/BlogFeatured.astro"
import AboutMe from "@/components/AboutMe.astro"
import ContactCta from "@/components/ContactCta.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import TitleSection from "@/components/TitleSection.astro"
import { publication } from "@/data/profile"
---

<Layout
  title="Jorge Espinoza — Consultor Oracle NetSuite & Full Stack Developer"
  description="Consultor y desarrollador con +4 años de experiencia en Oracle NetSuite, DevOps y full stack. Investigación en IA/ML publicada por Springer Nature. 15+ certificaciones Oracle, AWS y Google Cloud. Integraciones, SuiteScript, CI/CD e IA para empresas."
>
  <main>
    <div class="bg-grid pointer-events-none absolute inset-x-0 top-0 z-[-1] h-[38rem]" aria-hidden="true"></div>

    <!-- Hero + diferenciales -->
    <div class="mx-auto w-full max-w-5xl px-6 pt-32 md:pt-40">
      <Hero />
    </div>

    <!-- 01 Experiencia -->
    <SectionContainer id="experiencia" class="mt-24 md:mt-32">
      <TitleSection
        number="01"
        title="Experiencia"
        subtitle="Cinco años resolviendo problemas reales sobre Oracle NetSuite: manufactura farmacéutica, salud, retail, utilities y localización tributaria en Perú y Chile."
      />
      <Experience />
    </SectionContainer>

    <!-- 02 Proyectos -->
    <SectionContainer id="proyectos" class="mt-16 md:mt-24">
      <TitleSection
        number="02"
        title="Proyectos"
        subtitle="Proyectos personales con los que exploro nuevas tecnologías y arquitecturas fuera del ecosistema NetSuite."
      />
      <Projects />
    </SectionContainer>

    <!-- 03 Stack tecnológico -->
    <SectionContainer id="stack-tecnologico" class="mt-16 md:mt-24">
      <TitleSection
        number="03"
        title="Stack tecnológico"
        subtitle="Las herramientas con las que trabajo a diario para construir integraciones complejas y soluciones escalables."
      />
      <TechStack />
    </SectionContainer>

    <!-- 04 Certificaciones -->
    <SectionContainer id="certificaciones" class="mt-16 md:mt-24">
      <TitleSection
        number="04"
        title="Certificaciones"
        subtitle="Credenciales oficiales que validan mi expertise en Oracle Cloud, NetSuite, AWS, Google Cloud y desarrollo de software."
      />
      <Certifications />
    </SectionContainer>

    <!-- 05 Blog -->
    <SectionContainer id="blog" class="mt-16 md:mt-24">
      <TitleSection
        number="05"
        title="Blog técnico"
        subtitle="Apuntes sobre NetSuite, SuiteScript, integraciones y DevOps, basados en experiencia real de proyectos."
      />
      <BlogFeatured />
    </SectionContainer>

    <!-- 06 Sobre mí -->
    <SectionContainer id="sobre-mi" class="mt-16 md:mt-24">
      <TitleSection number="06" title="Sobre mí" />
      <AboutMe />
    </SectionContainer>

    <!-- Contacto -->
    <SectionContainer id="contacto" class="mt-24 md:mt-32">
      <ContactCta />
    </SectionContainer>
  </main>
</Layout>
