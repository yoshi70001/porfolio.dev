---
import Layout from "@/layouts/Layout.astro";

import AboutMe from "@/components/AboutMe.astro";
import Briefcase from "@/components/icons/Briefcase.astro";
import CodeIcon from "@/components/icons/Code.astro";
import Experience from "@/components/Experience.astro";
import ProfileCheck from "@/components/icons/ProfileCheck.astro";
import Projects from "@/components/Projects.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Hero from "@/components/Hero.astro";
import TitleSection from "@/components/TitleSection.astro";
import BlogFeatured from "@/components/BlogFeatured.astro";
import WhyMe from "@/components/WhyMe.astro";
import TechStack from "@/components/TechStack.astro";
import SpringerPublication from "@/components/SpringerPublication.astro";
import Achievements from "@/components/Achievements.astro";
import Certifications from "@/components/Certifications.astro";
---

<Layout
  title="Jorge Espinoza | DevOps & NetSuite Developer | AI Researcher Published by Springer"
  description="DevOps Engineer & NetSuite Developer con investigación en IA/ML publicada por Springer Nature. 15+ certificaciones Oracle. Experiencia en Joyit, 2win y LatamReady. Especialista en integraciones, CI/CD y Machine Learning para toma de decisiones."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero />
    </SectionContainer>
  </main>
  <div class="space-y-24">
    <!-- Publicación Springer Nature (sección destacada especial) -->
    <SpringerPublication />

    <!-- Logros Destacados -->
    <Achievements />

    <!-- Experiencia Profesional -->
    <SectionContainer id="experiencia">
      <TitleSection>
        <Briefcase class="size-8" />
        Experiencia Profesional
      </TitleSection>
      <Experience />
    </SectionContainer>

    <!-- Certificaciones Profesionales -->
    <Certifications />

    <!-- Blog Técnico -->
    <BlogFeatured />

    <!-- Por Qué Me Eligen -->
    <WhyMe />

    <!-- Proyectos Técnicos -->
    <SectionContainer id="proyectos">
      <TitleSection>
        <CodeIcon class="size-7" />
        Proyectos Técnicos
      </TitleSection>
      <Projects />
    </SectionContainer>

    <!-- Stack Tecnológico -->
    <TechStack />

    <!-- Sobre mí -->
    <SectionContainer id="sobre-mi">
      <TitleSection>
        <ProfileCheck class="size-8" />
        Sobre mí
      </TitleSection>
      <AboutMe />
    </SectionContainer>
  </div>
</Layout>