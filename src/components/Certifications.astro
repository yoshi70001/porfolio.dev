---
import { certifications, totalCertifications } from "@/data/profile"
---

<div class="divide-y divide-paper-200 dark:divide-ink-800">
  {
    certifications.map((group) => (
      <div class="grid gap-3 py-6 md:grid-cols-[16rem_1fr] md:gap-8">
        <h3 class="flex items-baseline gap-3 font-display text-base font-semibold text-ink-900 dark:text-paper-50">
          <span class="font-mono text-xs font-medium text-ink-400 dark:text-ink-500" aria-hidden="true">
            {String(group.items.length).padStart(2, "0")}
          </span>
          {group.category}
        </h3>
        <ul class="grid gap-x-10 sm:grid-cols-2">
          {group.items.map((item) => (
            <li class="flex items-center gap-2.5 border-b border-paper-200/70 py-2.5 text-sm text-ink-700 last:border-b-0 dark:border-ink-800/70 dark:text-ink-300">
              <svg class="size-3.5 shrink-0 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<p class="mt-6 font-mono text-xs uppercase tracking-[0.15em] text-ink-500 dark:text-ink-400">
  {totalCertifications} certificaciones oficiales · actualización constante
</p>
