---
import SectionContainer from "./SectionContainer.astro"
import TitleSection from "./TitleSection.astro"
---

<SectionContainer id="certificaciones">
  <TitleSection>
    <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
    </svg>
    Certificaciones Profesionales
  </TitleSection>
  
  <p class="mt-4 text-lg text-gray-600 dark:text-gray-400 max-w-2xl">
    15+ certificaciones oficiales que validan mi expertise en Oracle Cloud, NetSuite, AWS, 
    Google Cloud y desarrollo de software.
  </p>
  
  <div class="grid gap-6 mt-12 lg:grid-cols-3">
    <!-- Oracle NetSuite -->
    <div class="p-6 bg-white rounded-xl shadow-sm dark:bg-gray-800 border border-blue-200 dark:border-blue-800">
      <h3 class="mb-4 text-lg font-bold text-blue-700 dark:text-blue-400 flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0z"/>
        </svg>
        Oracle NetSuite
      </h3>
      <ul class="space-y-2">
        <li class="cert-item">BI and Reporting Associate</li>
        <li class="cert-item">Financial Associate</li>
        <li class="cert-item">AI Foundations Associate</li>
      </ul>
    </div>
    
    <!-- Oracle Fusion Cloud -->
    <div class="p-6 bg-white rounded-xl shadow-sm dark:bg-gray-800 border border-purple-200 dark:border-purple-800">
      <h3 class="mb-4 text-lg font-bold text-purple-700 dark:text-purple-400 flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M11 17a1 1 0 001.447.894l4-2A1 1 0 0017 15V9.236a1 1 0 00-1.447-.894l-4 2a1 1 0 00-.553.894V17zM15.211 6.276a1 1 0 000-1.788l-4.764-2.382a1 1 0 00-.894 0L4.789 4.488a1 1 0 000 1.788l4.764 2.382a1 1 0 00.894 0l4.764-2.382zM4.447 8.342A1 1 0 003 9.236V15a1 1 0 00.553.894l4 2A1 1 0 009 17v-5.764a1 1 0 00-.553-.894l-4-2z"/>
        </svg>
        Oracle Fusion Cloud
      </h3>
      <ul class="space-y-2">
        <li class="cert-item">CX Process Essentials</li>
        <li class="cert-item">ERP Process Essentials</li>
        <li class="cert-item">HCM Process Essentials</li>
        <li class="cert-item">SCM Process Essentials</li>
      </ul>
    </div>
    
    <!-- Oracle Cloud Infrastructure -->
    <div class="p-6 bg-white rounded-xl shadow-sm dark:bg-gray-800 border border-orange-200 dark:border-orange-800">
      <h3 class="mb-4 text-lg font-bold text-orange-700 dark:text-orange-400 flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M2 5a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm14 1a1 1 0 11-2 0 1 1 0 012 0zM2 13a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 01-2 2H4a2 2 0 01-2-2v-2zm14 1a1 1 0 11-2 0 1 1 0 012 0z" clip-rule="evenodd"/>
        </svg>
        Oracle Cloud
      </h3>
      <ul class="space-y-2">
        <li class="cert-item">OCI AI Foundations Associate</li>
        <li class="cert-item">OCI Foundations Associate</li>
      </ul>
    </div>
    
    <!-- Cloud Platforms -->
    <div class="p-6 bg-white rounded-xl shadow-sm dark:bg-gray-800 border border-cyan-200 dark:border-cyan-800">
      <h3 class="mb-4 text-lg font-bold text-cyan-700 dark:text-cyan-400 flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.321-1.029.812-.21.165.18.227.65.819-.972.389-.819.65-.165.21-.812 1.029.321-.804.49-.123H15a2 2 0 002-2V5zM5 5a1 1 0 00-1 1v.918c.44.069.874.168 1.3.293V6a1 1 0 001-1V5zm2.3 2.825l.27-.54a1 1 0 011.788 0l.27.54a1 1 0 01.638.637l.54.27a1 1 0 010 1.788l-.54.27a1 1 0 01-.637.638l-.27.54a1 1 0 01-1.788 0l-.27-.54a1 1 0 01-.638-.637l-.54-.27a1 1 0 010-1.788l.54-.27a1 1 0 01.637-.638z" clip-rule="evenodd"/>
        </svg>
        Cloud Platforms
      </h3>
      <ul class="space-y-2">
        <li class="cert-item">AWS Cloud Practitioner</li>
        <li class="cert-item">Google Cloud Computing Foundations</li>
        <li class="cert-item">FinOps Foundation</li>
      </ul>
    </div>
    
    <!-- Desarrollo -->
    <div class="p-6 bg-white rounded-xl shadow-sm dark:bg-gray-800 border border-emerald-200 dark:border-emerald-800">
      <h3 class="mb-4 text-lg font-bold text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
        Desarrollo
      </h3>
      <ul class="space-y-2">
        <li class="cert-item">SQL PostgreSQL (DevTalles)</li>
        <li class="cert-item">Clean Code & SOLID (Udemy)</li>
        <li class="cert-item">Node.js Authentication (DevTalles)</li>
        <li class="cert-item">TypeScript (Platzi)</li>
        <li class="cert-item">Python Profesional</li>
      </ul>
    </div>
    
    <!-- Arquitectura -->
    <div class="p-6 bg-white rounded-xl shadow-sm dark:bg-gray-800 border border-pink-200 dark:border-pink-800">
      <h3 class="mb-4 text-lg font-bold text-pink-700 dark:text-pink-400 flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
        </svg>
        Arquitectura & Soft Skills
      </h3>
      <ul class="space-y-2">
        <li class="cert-item">Fundamentos de Ingeniería de Software</li>
        <li class="cert-item">Autenticación & Microservicios</li>
        <li class="cert-item">EF SET English B1 (Proficient)</li>
      </ul>
    </div>
  </div>
</SectionContainer>

<style>
  .cert-item {
    @apply flex items-center gap-2 px-3 py-2 text-sm text-gray-700 bg-gray-50 rounded-lg dark:text-gray-300 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600;
  }
  
  .cert-item::before {
    content: "✓";
    @apply font-bold text-green-600 dark:text-green-400;
  }
</style>