---
import { getCollection } from "astro:content"
import LinkInline from "./LinkInline.astro"

const allPosts = await getCollection("blog")
const featuredPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<div class="flex flex-col">
  {
    featuredPosts.map((post) => (
      <a
        href={`/blog/${post.id}`}
        class="group grid gap-2 border-t border-paper-200 py-6 transition-colors last:border-b hover:bg-paper-50 md:grid-cols-[9rem_1fr_auto] md:items-baseline md:gap-8 dark:border-ink-800 dark:hover:bg-ink-900/50"
      >
        <time
          datetime={post.data.pubDate.toISOString()}
          class="font-mono text-xs uppercase tracking-[0.15em] text-ink-500 dark:text-ink-400"
        >
          {post.data.pubDate.toLocaleDateString("es-PE", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })}
        </time>

        <div>
          <h3 class="font-display text-xl font-semibold tracking-tight text-ink-900 transition-colors group-hover:text-accent-700 dark:text-paper-50 dark:group-hover:text-accent-400">
            {post.data.title}
          </h3>
          <p class="mt-1.5 leading-relaxed text-ink-600 line-clamp-2 dark:text-ink-300">
            {post.data.description}
          </p>
          {post.data.tags && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <li class="rounded border border-paper-300 px-2 py-0.5 font-mono text-[11px] text-ink-500 dark:border-ink-700 dark:text-ink-400">
                  {tag}
                </li>
              ))}
            </ul>
          )}
        </div>

        <span
          class="hidden font-mono text-sm text-accent-700 transition-transform duration-200 group-hover:translate-x-1 md:inline dark:text-accent-400"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    ))
  }
</div>

<div class="mt-8">
  <LinkInline href="/blog">Ver todos los artículos →</LinkInline>
</div>
