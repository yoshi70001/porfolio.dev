---
interface Props {
  href: string
  external?: boolean
  class?: string
}

const { href, external = false, class: className } = Astro.props
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[
    "inline-flex items-center gap-1 font-medium text-accent-700 underline decoration-accent-300 underline-offset-4 transition-colors hover:text-accent-800 hover:decoration-accent-600 dark:text-accent-400 dark:decoration-accent-700 dark:hover:text-accent-300 dark:hover:decoration-accent-400",
    className,
  ]}
>
  <slot />
</a>
