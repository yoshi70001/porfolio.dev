---
import { stack } from "@/data/profile"
---

<div class="divide-y divide-paper-200 dark:divide-ink-800">
  {
    stack.map((group, i) => (
      <div class="grid gap-3 py-6 md:grid-cols-[14rem_1fr] md:gap-8">
        <h3 class="flex items-baseline gap-3 font-display text-base font-semibold text-ink-900 dark:text-paper-50">
          <span class="font-mono text-xs font-medium text-ink-400 dark:text-ink-500" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          {group.name}
        </h3>
        <ul class="flex flex-wrap gap-1.5">
          {group.items.map((item) => (
            <li class="rounded border border-paper-300 px-2.5 py-1 font-mono text-xs text-ink-600 dark:border-ink-700 dark:text-ink-300">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
