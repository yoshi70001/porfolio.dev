---
interface Props {
  number: string
  title: string
  subtitle?: string
}

const { number, title, subtitle } = Astro.props
---

<div class="mb-10 md:mb-14">
  <p
    class="flex items-center gap-3 font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-700 dark:text-accent-400"
  >
    <span>{number}</span>
    <span class="h-px w-10 bg-accent-600/40 dark:bg-accent-400/40" aria-hidden="true"></span>
  </p>
  <h2
    class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink-900 md:text-4xl dark:text-paper-50"
  >
    {title}
  </h2>
  {subtitle && (
    <p class="mt-3 max-w-2xl leading-relaxed text-ink-600 dark:text-ink-300">
      {subtitle}
    </p>
  )}
</div>
