---
import GitHubIcon from "./icons/GitHub.astro"
import LinkIcon from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import { projects } from "@/data/profile"
---

<div class="flex flex-col gap-16 md:gap-20">
  {
    projects.map((project, i) => (
      <article class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
        <a
          href={project.url ?? project.repo}
          target="_blank"
          rel="noopener noreferrer"
          class:list={["group block overflow-hidden rounded-lg border border-paper-200 bg-paper-50 shadow-sm transition-shadow hover:shadow-md dark:border-ink-800 dark:bg-ink-900", i % 2 === 1 && "md:order-2"]}
        >
          <img
            src={project.image}
            alt={project.imageAlt}
            loading="lazy"
            class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.02]"
          />
        </a>

        <div class:list={[i % 2 === 1 && "md:order-1"]}>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent-700 dark:text-accent-400">
            {String(i + 1).padStart(2, "0")} — Proyecto
          </p>
          <h3 class="mt-2 font-display text-2xl font-semibold tracking-tight text-ink-900 dark:text-paper-50">
            {project.name}
          </h3>
          <p class="mt-3 leading-relaxed text-ink-600 dark:text-ink-300">
            {project.description}
          </p>

          <ul class="mt-4 flex flex-wrap gap-1.5">
            {project.tech.map((tech) => (
              <li class="rounded border border-paper-300 px-2 py-0.5 font-mono text-[11px] text-ink-600 dark:border-ink-700 dark:text-ink-300">
                {tech}
              </li>
            ))}
          </ul>

          <div class="mt-6 flex flex-wrap gap-3">
            {project.repo && (
              <LinkButton href={project.repo} variant="ghost" external>
                <GitHubIcon class="size-4" />
                Ver código
              </LinkButton>
            )}
            {project.url && (
              <LinkButton href={project.url} variant="ghost" external>
                <LinkIcon class="size-4" />
                Demo en vivo
              </LinkButton>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>
