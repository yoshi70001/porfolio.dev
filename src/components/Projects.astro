---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import Express from "./icons/Express.astro";
import Ejs from "./icons/Ejs.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  EXPRESS: {
    name: "Express",
    class: "bg-[#003159] text-white",
    icon: Express,
  },
  EJS: {
    name: "EJS",
    class: "bg-[#003159] text-white",
    icon: Ejs,
  },
};

const PROJECTS = [
  {
    title: "HardSub Extractor",
    description:
      "Aplicación de escritorio para extracción de HardSubs usando redes neuronales para detección y OCR en tiempo real. Arquitectura modular con procesamiento paralelo de video.",
    github: "https://github.com/yoshi70001/HardSubExtractor",
    image: "/projects/harsubextractor.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND],
    tech: "Next.js + Tailwind + OCR"
  },
  {
    title: "Animeflv Wrapper",
    description:
      "API wrapper web para streaming de anime en español. Implementada con Express y EJS, utiliza web scraping para obtención de contenido y caché para optimización de respuestas.",
    link: "https://jespinoza.mooo.com/anime/",
    github: "https://github.com/yoshi70001/animeflvWrapper",
    image: "/projects/animeflvWrapper.webp",
    tags: [TAGS.EXPRESS, TAGS.EJS],
    tech: "Express + EJS + Cheerio"
  },
  {
    title: "ScreenShot Site",
    description:
      "Servicio de capturas de pantalla de sitios web bajo demanda. Arquitectura serverless con colas de procesamiento y almacenamiento optimizado para alta disponibilidad.",
    link: "https://jespinoza.mooo.com/screenshot/",
    github: "https://github.com/yoshi70001/screenshot-site",
    image: "/projects/screenShot.webp",
    tags: [TAGS.EXPRESS, TAGS.EJS],
    tech: "Express + Puppeteer"
  },
];
---

<div class="flex flex-col gap-y-16">
  <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl">
    Proyectos personales y experimentales que desarrollo fuera de mi trabajo principal en NetSuite. 
    Cada proyecto representa exploración de nuevas tecnologías y arquitecturas.
  </p>

  {
    PROJECTS.map(({ image, title, description, tags, link, github, tech }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              alt={title}
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <div class="mb-2">
            <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wide">
              {tech}
            </span>
          </div>
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-3">
            <ul class="flex flex-row mb-3 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400 leading-relaxed">
              {description}
            </div>
            <footer class="flex items-end justify-start mt-6 gap-x-4">
              {github && (
                <LinkButton href={github} class="px-4 py-2">
                  <GitHub class="size-5" />
                  Ver Código
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link} class="px-4 py-2">
                  <Link class="size-4" />
                  Demo en vivo
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>