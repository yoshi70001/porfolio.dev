---
const personalImageAlt = "Jorge Luis";
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
---

<div class="max-w-4xl">
  <div class="flex flex-col gap-6 mb-8 md:flex-row md:items-center">
    <img
      class="rounded-full shadow-xl size-20 ring-4 ring-blue-500/20"
      src="/Jorge.webp"
      alt={personalImageAlt}
    />
    <div class="flex flex-col gap-2">
      <div class="flex flex-wrap gap-2">
        <a
          href="https://link.springer.com/chapter/10.1007/978-3-031-77493-5_13"
          target="_blank"
          rel="noopener"
          class="transition-transform hover:scale-105"
        >
          <Badge class="bg-amber-600 text-white border-amber-700">🏆 Springer Nature Published</Badge>
        </a>
        <a
          href="https://linkedin.com/in/jorge-luis-emmanuel-espinoza-espinoza-b271591b9/"
          target="_blank"
          rel="noopener"
          class="transition-transform hover:scale-105"
        >
          <Badge class="bg-blue-600 text-white border-blue-700">Disponible para Proyectos</Badge>
        </a>
      </div>
      <p class="text-sm font-medium text-gray-600 dark:text-gray-400">
        Actualmente en <span class="font-semibold text-blue-600 dark:text-blue-400">Joyit</span> + <span class="font-semibold text-blue-600 dark:text-blue-400">2win</span> • 
        <span class="font-semibold text-amber-600 dark:text-amber-400">AI Researcher</span> publicado
      </p>
    </div>
  </div>
  
  <h1
    class="text-5xl font-bold tracking-tight text-gray-900 sm:text-6xl dark:text-white"
  >
    DevOps | NetSuite | Backend | AI Researcher
  </h1>
  <p
    class="mt-6 text-xl text-gray-700 dark:text-gray-300 leading-relaxed"
  >
    <strong class="text-blue-600 dark:text-blue-400">Desarrollador con +4 años de experiencia</strong> en integraciones complejas, 
    automatización de procesos y <strong class="text-amber-600 dark:text-amber-400">investigación en IA/ML publicada por Springer Nature</strong>. 
    Especializado en NetSuite, DevOps y desarrollo backend con arquitectura limpia.
  </p>
  
  <div class="flex flex-wrap gap-3 mt-6">
    <span class="inline-flex items-center px-3 py-1.5 text-sm font-medium bg-gray-100 rounded-full text-gray-700 dark:bg-gray-800 dark:text-gray-300">
      SuiteScript 2.0
    </span>
    <span class="inline-flex items-center px-3 py-1.5 text-sm font-medium bg-gray-100 rounded-full text-gray-700 dark:bg-gray-800 dark:text-gray-300">
      DevOps & CI/CD
    </span>
    <span class="inline-flex items-center px-3 py-1.5 text-sm font-medium bg-gray-100 rounded-full text-gray-700 dark:bg-gray-800 dark:text-gray-300">
      AI & Machine Learning
    </span>
    <span class="inline-flex items-center px-3 py-1.5 text-sm font-medium bg-gray-100 rounded-full text-gray-700 dark:bg-gray-800 dark:text-gray-300">
      Clean Architecture
    </span>
  </div>
  
  <nav class="flex flex-wrap gap-4 mt-10">
    <SocialPill 
      href="mailto:jespinozaespinoza@outlook.com"
      class="px-6 py-3 text-base font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
    >
      <!-- <MailIcon class="size-5" /> -->
      Hablemos de tu Proyecto
    </SocialPill>
    <SocialPill
      href="#logros"
      class="px-6 py-3 text-base font-semibold bg-amber-600 hover:bg-amber-700 text-white rounded-lg transition-colors"
    >
      Ver Mis Logros
    </SocialPill>
  </nav>
</div>