---
import Badge from "./Badge.astro"
import LinkButton from "./LinkButton.astro"
import LinkInline from "./LinkInline.astro"
import { highlights, identity, publication } from "@/data/profile"
---

<div>
  <div class="grid items-center gap-12 lg:grid-cols-[1fr_16rem]">
    <div class="flex flex-col">
      <div class="reveal flex flex-wrap items-center gap-x-5 gap-y-3">
        {identity.available && <Badge>Disponible para proyectos</Badge>}
        <span
          class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500 dark:text-ink-400"
        >
          {identity.role}
        </span>
      </div>

      <h1
        class="reveal mt-7 font-display text-5xl font-semibold tracking-tight text-ink-900 sm:text-6xl dark:text-paper-50"
        style="animation-delay: 0.08s"
      >
        {identity.name}
      </h1>

      <p
        class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-ink-700 dark:text-ink-200"
        style="animation-delay: 0.16s"
      >
        Consultor y desarrollador con
        <strong class="font-semibold text-ink-900 dark:text-paper-50">
          +4 años construyendo módulos e integraciones sobre Oracle NetSuite
        </strong>
        para manufactura, salud y retail — y desarrollo full stack cuando el proyecto lo exige.
        Investigación en IA/ML publicada por
        <LinkInline href={publication.url} external>Springer Nature</LinkInline>.
      </p>

      <div class="reveal mt-9 flex flex-wrap gap-3" style="animation-delay: 0.24s">
        <LinkButton href="/#contacto" variant="primary">Hablemos de tu proyecto</LinkButton>
        <LinkButton href="/#experiencia" variant="ghost">Ver experiencia</LinkButton>
      </div>
    </div>

    <figure class="reveal hidden justify-self-center sm:block lg:justify-self-end" style="animation-delay: 0.2s">
      <div class="relative">
        <img
          src={identity.photo}
          alt={identity.photoAlt}
          width="256"
          height="256"
          class="size-56 rounded-md object-cover object-center ring-1 ring-ink-900/10 lg:size-64 dark:ring-paper-50/10"
        />
        <span class="absolute -left-2.5 -top-2.5 h-6 w-6 border-l-2 border-t-2 border-accent-600 dark:border-accent-400" aria-hidden="true"></span>
        <span class="absolute -right-2.5 -top-2.5 h-6 w-6 border-r-2 border-t-2 border-accent-600 dark:border-accent-400" aria-hidden="true"></span>
        <span class="absolute -bottom-2.5 -left-2.5 h-6 w-6 border-b-2 border-l-2 border-accent-600 dark:border-accent-400" aria-hidden="true"></span>
        <span class="absolute -bottom-2.5 -right-2.5 h-6 w-6 border-b-2 border-r-2 border-accent-600 dark:border-accent-400" aria-hidden="true"></span>
      </div>
      <figcaption
        class="mt-4 text-center font-mono text-[11px] uppercase tracking-[0.16em] text-ink-500 dark:text-ink-400"
      >
        {identity.title} — {identity.location}
      </figcaption>
    </figure>
  </div>

  <dl
    class="mt-16 grid grid-cols-1 gap-x-8 gap-y-8 border-t border-paper-200 pt-10 sm:grid-cols-2 md:mt-20 lg:grid-cols-4 dark:border-ink-800"
  >
    {
      highlights.map((item) => (
        <div class="reveal">
          <dd class="font-display text-3xl font-semibold tracking-tight text-ink-900 dark:text-paper-50">
            {item.href ? (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="transition-colors hover:text-accent-700 dark:hover:text-accent-400"
              >
                {item.value}
                {item.external && <span class="ml-1 align-super text-base" aria-hidden="true">↗</span>}
              </a>
            ) : (
              item.value
            )}
          </dd>
          <dt class="mt-2 max-w-[16rem] text-sm leading-snug text-ink-500 dark:text-ink-400">
            {item.label}
          </dt>
        </div>
      ))
    }
  </dl>
</div>
