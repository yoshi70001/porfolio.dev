---
import LinkInline from "./LinkInline.astro"
import type { ExperienceEntry } from "@/data/profile"

interface Props extends ExperienceEntry {}

const { company, role, period, url, summary, areas, stack } = Astro.props
---

<article class="grid gap-6 border-t border-paper-200 py-10 first:border-t-0 md:grid-cols-[15rem_1fr] md:gap-12 md:py-12 dark:border-ink-800">
  <div class="self-start md:sticky md:top-24">
    <p class="font-mono text-xs uppercase tracking-[0.15em] text-ink-500 dark:text-ink-400">
      {period}
    </p>
    <h3 class="mt-2 font-display text-xl font-semibold tracking-tight text-ink-900 dark:text-paper-50">
      {company}
    </h3>
    <p class="mt-1 text-sm leading-snug text-ink-600 dark:text-ink-300">{role}</p>
    {
      url && (
        <LinkInline href={url} external class="mt-3 text-sm">
          Sitio web ↗
        </LinkInline>
      )
    }
  </div>

  <div class="flex flex-col gap-6">
    <p class="leading-relaxed text-ink-700 dark:text-ink-200">{summary}</p>

    {
      areas?.map((area) => (
        <section>
          <h4 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-accent-700 dark:text-accent-400">
            {area.heading}
          </h4>
          <ul class="mt-3 flex flex-col gap-2">
            {area.items.map((item) => (
              <li class="flex gap-3 leading-relaxed text-ink-600 dark:text-ink-300">
                <span class="mt-[0.6rem] size-1 shrink-0 rounded-full bg-accent-600/80 dark:bg-accent-400/80" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      stack && stack.length > 0 && (
        <ul class="flex flex-wrap gap-1.5 pt-1">
          {stack.map((tech) => (
            <li class="rounded border border-paper-300 px-2 py-0.5 font-mono text-[11px] text-ink-600 dark:border-ink-700 dark:text-ink-300">
              {tech}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
