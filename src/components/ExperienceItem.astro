---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
  sections?: {
    heading: string
    items: string[]
  }[]
  stack?: string[]
}

const { title, company, description, link, date, sections, stack } = Astro.props
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4]"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="text-yellow-400 -left-[42px] absolute rounded-full text-5xl"
        >&bull;</span
      >

      <h3 class="text-xl font-bold text-yellow-400">{title}</h3>
      <h4 class="font-semibold text-xl text-gray-600 dark:text-white">{company}</h4>
      <time class="p-0 m-0 text-sm text-gray-600/80 dark:text-white/80">{date}</time>
    </div>
  </div>
  <div class="relative flex flex-col gap-4 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3">
    <p class="leading-relaxed">{description}</p>
    {
      sections?.map((section) => (
        <section class="flex flex-col gap-2">
          <h5 class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wide">
            {section.heading}
          </h5>
          <ul class="flex flex-col gap-1.5 list-disc pl-5 leading-relaxed">
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }
    {
      stack && stack.length > 0 && (
        <ul class="flex flex-wrap gap-2 pt-1">
          {stack.map((tech) => (
            <li class="inline-flex items-center px-2.5 py-1 text-xs font-medium bg-gray-100 rounded-full text-gray-700 dark:bg-gray-800 dark:text-gray-300">
              {tech}
            </li>
          ))}
        </ul>
      )
    }
    {
      link && (
        <LinkInline href={link}>
          Saber más{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
