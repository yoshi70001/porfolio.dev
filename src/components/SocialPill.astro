---
interface Props {
  href: string
  class?: string
}

const { href, class: className } = Astro.props
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "inline-flex items-center gap-2 rounded-lg border border-paper-300 px-3.5 py-2 font-mono text-xs uppercase tracking-wider text-ink-700 transition-colors duration-200 hover:border-accent-600 hover:text-accent-700 dark:border-ink-700 dark:text-ink-200 dark:hover:border-accent-400 dark:hover:text-accent-400",
    className,
  ]}
>
  <slot />
</a>
