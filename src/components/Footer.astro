---
import { identity, socials } from "@/data/profile"
import GitHubIcon from "./icons/GitHub.astro"
import LinkedInIcon from "./icons/LinkedIn.astro"
import MailIcon from "./icons/Mail.astro"

const currentYear = new Date().getFullYear()
---

<footer class="mt-20 border-t border-paper-200 dark:border-ink-800">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-10 md:flex-row md:items-center md:justify-between"
  >
    <div>
      <p class="font-mono text-sm font-semibold text-ink-900 dark:text-paper-50">
        Jorge<span class="text-accent-600 dark:text-accent-400">/</span>dev
      </p>
      <p class="mt-1.5 text-sm text-ink-500 dark:text-ink-400">
        © {currentYear} {identity.name} · {identity.title} · {identity.location}
      </p>
    </div>

    <ul class="flex flex-wrap items-center gap-2">
      <li>
        <a
          href={socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-paper-300 px-3.5 py-2 font-mono text-xs uppercase tracking-wider text-ink-700 transition-colors hover:border-accent-600 hover:text-accent-700 dark:border-ink-700 dark:text-ink-200 dark:hover:border-accent-400 dark:hover:text-accent-400"
        >
          <GitHubIcon class="size-4" />
          GitHub
        </a>
      </li>
      <li>
        <a
          href={socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-paper-300 px-3.5 py-2 font-mono text-xs uppercase tracking-wider text-ink-700 transition-colors hover:border-accent-600 hover:text-accent-700 dark:border-ink-700 dark:text-ink-200 dark:hover:border-accent-400 dark:hover:text-accent-400"
        >
          <LinkedInIcon class="size-4" />
          LinkedIn
        </a>
      </li>
      <li>
        <a
          href={socials.email}
          class="inline-flex items-center gap-2 rounded-lg border border-paper-300 px-3.5 py-2 font-mono text-xs uppercase tracking-wider text-ink-700 transition-colors hover:border-accent-600 hover:text-accent-700 dark:border-ink-700 dark:text-ink-200 dark:hover:border-accent-400 dark:hover:text-accent-400"
        >
          <MailIcon class="size-4" />
          Email
        </a>
      </li>
    </ul>
  </div>
</footer>
