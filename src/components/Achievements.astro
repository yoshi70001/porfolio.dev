---
import SectionContainer from "./SectionContainer.astro"
import TitleSection from "./TitleSection.astro"
---

<SectionContainer id="logros">
  <TitleSection>
    <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    Logros Destacados
  </TitleSection>
  
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    <!-- Logro 1: Springer Nature -->
    <div class="p-6 bg-gradient-to-br from-amber-50 to-yellow-50 rounded-xl border-2 border-amber-200 dark:from-amber-900/20 dark:to-yellow-900/20 dark:border-amber-800 hover:shadow-lg transition-shadow">
      <div class="text-4xl mb-3">🏆</div>
      <div class="text-3xl font-bold text-amber-700 dark:text-amber-400 mb-2">
        Springer
      </div>
      <p class="text-sm text-gray-700 dark:text-gray-300 leading-snug">
        Investigador publicado en IA/ML por Springer Nature (IBIMA 2024)
      </p>
    </div>
    
    <!-- Logro 2: 40% reducción costos -->
    <div class="p-6 bg-gradient-to-br from-blue-50 to-cyan-50 rounded-xl border border-blue-200 dark:from-blue-900/20 dark:to-cyan-900/20 dark:border-blue-800 hover:shadow-lg transition-shadow">
      <div class="text-4xl mb-3">💰</div>
      <div class="text-3xl font-bold text-blue-700 dark:text-blue-400 mb-2">
        40%
      </div>
      <p class="text-sm text-gray-700 dark:text-gray-300 leading-snug">
        Reducción de costos operativos migrando de AWS a Oracle Cloud
      </p>
    </div>
    
    <!-- Logro 3: 30% mejora reportes -->
    <div class="p-6 bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl border border-emerald-200 dark:from-emerald-900/20 dark:to-green-900/20 dark:border-emerald-800 hover:shadow-lg transition-shadow">
      <div class="text-4xl mb-3">📊</div>
      <div class="text-3xl font-bold text-emerald-700 dark:text-emerald-400 mb-2">
        30%
      </div>
      <p class="text-sm text-gray-700 dark:text-gray-300 leading-snug">
        Mejora en tiempos de generación de reportes de negocio
      </p>
    </div>
    
    <!-- Logro 4: 20% eficiencia despliegues -->
    <div class="p-6 bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl border border-purple-200 dark:from-purple-900/20 dark:to-pink-900/20 dark:border-purple-800 hover:shadow-lg transition-shadow">
      <div class="text-4xl mb-3">⚡</div>
      <div class="text-3xl font-bold text-purple-700 dark:text-purple-400 mb-2">
        20%
      </div>
      <p class="text-sm text-gray-700 dark:text-gray-300 leading-snug">
        Mejora en eficiencia de despliegues con CI/CD y mejores prácticas
      </p>
    </div>
  </div>
</SectionContainer>